# ==============================================================================
# VoiceGuard AI Backend — Local Environment Configuration
# ==============================================================================

# Server Network Settings
VOICEGUARD_HOST=127.0.0.1
VOICEGUARD_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local MongoDB Community Database
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=voiceguard_db
MONGODB_COLLECTION=detection_history
MONGODB_TIMEOUT_MS=2000

# Model Decision Threshold
DECISION_THRESHOLD=0.5
