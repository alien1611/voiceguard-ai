# ==============================================================================
# VoiceGuard AI — Local Environment Configuration (.env.example)
# ==============================================================================
# This application is strictly 100% local. Zero cloud services or external APIs.
# Copy this file to '.env' if custom configuration overrides are needed.
# ==============================================================================

# Backend Server Configuration
VOICEGUARD_HOST=127.0.0.1
VOICEGUARD_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local MongoDB Community Server
# Ensure MongoDB Community Server daemon is running locally on port 27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=voiceguard_db
MONGODB_COLLECTION=detection_history
MONGODB_TIMEOUT_MS=2000

# Classification Threshold
# Uncalibrated sigmoid output: score >= 0.50 => SPOOF; score < 0.50 => BONAFIDE
DECISION_THRESHOLD=0.5
